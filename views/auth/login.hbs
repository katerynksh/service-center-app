<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log In — Service Center</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        :root {
            --primary-purple: #cbbdf0;
            --hover-purple: #b8a9e0;
            --bg-body: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #2d3748;
            --text-sub: #718096;
            --border-color: #e2e8f0;
            --input-bg: #fcfcfc;
            --error-bg: #fff5f5;
            --error-text: #e53e3e;
            --error-border: #feb2b2;
        }

        body.dark-theme {
            --bg-body: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f1f5f9;
            --text-sub: #94a3b8;
            --border-color: #334155;
            --input-bg: #0f172a;
            --error-bg: rgba(229, 62, 62, 0.1);
            --error-text: #fc8181;
            --error-border: rgba(229, 62, 62, 0.2);
        }

        body, html {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Inter', -apple-system, sans-serif;
            background-color: var(--bg-body);
            transition: background-color 0.3s ease;
        }

        .theme-toggle {
            position: fixed;
            top: 20px;
            right: 20px;
            width: 44px;
            height: 44px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            color: var(--text-main);
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            z-index: 1000;
        }

        .back-home {
            position: fixed;
            top: 20px;
            left: 20px;
            padding: 0 16px; 
            height: 44px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px; 
            cursor: pointer;
            color: var(--text-main);
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            z-index: 1000;
            text-decoration: none;
            transition: all 0.2s ease;
            font-weight: 600; 
            font-size: 14px;
        }

        .back-home:hover {
            border-color: var(--primary-purple);
            color: var(--primary-purple);
            transform: translateX(-3px);
        }

        .auth-container {
            width: 100%;
            max-width: 400px; 
            padding: 20px;
            box-sizing: border-box;
            text-align: center;
        }

        .logo-box {
            background-color: var(--primary-purple);
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 auto 15px;
            color: white;
            font-size: 24px;
            box-shadow: 0 4px 12px rgba(203, 189, 240, 0.4);
        }

        .brand-name {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 25px 0;
        }

        .auth-card {
            background: var(--card-bg);
            padding: 45px 40px; 
            border-radius: 28px;
            border: 1px solid var(--border-color);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
            box-sizing: border-box;
        }

        .auth-card h2 {
            margin: 0 0 25px 0;
            font-size: 20px;
            color: var(--text-main);
            font-weight: 600;
        }

        .error-banner {
            background-color: var(--error-bg);
            color: var(--error-text);
            padding: 12px;
            border-radius: 12px;
            border: 1px solid var(--error-border);
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .form-group {
            text-align: left;
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-main);
        }

        .form-input {
            width: 100%;
            padding: 13px 15px;
            border: 2px solid var(--border-color);
            border-radius: 12px;
            font-size: 15px;
            background-color: var(--input-bg);
            color: var(--text-main);
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--primary-purple);
            box-shadow: 0 0 0 4px rgba(203, 189, 240, 0.2);
        }

        .btn-submit {
            width: 100%;
            background-color: var(--primary-purple);
            color: white;
            padding: 14px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: opacity 0.2s;
            margin-top: 10px;
        }

        .demo-section {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
        }

        .demo-label {
            display: block;
            font-size: 11px;
            font-weight: 800;
            color: var(--text-sub);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
            text-align: left;
        }

        .demo-pill {
            background: var(--input-bg);
            padding: 11px;
            border-radius: 12px;
            font-size: 12px;
            color: var(--text-sub);
            margin-bottom: 8px;
            border: 1px solid var(--border-color);
            cursor: pointer;
            text-align: left;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s ease;
        }

        .demo-pill:hover {
            border-color: var(--primary-purple);
            color: var(--text-main);
            transform: translateX(4px);
        }

        .demo-pill b { color: var(--text-main); }

        .error-message {
            color: #e53e3e;
            font-size: 12px;
            margin-top: 5px;
            font-weight: 500;
        }

        .form-input.is-invalid {
            border-color: #fc8181 ;
            background-color: #fff5f5 ;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i.error-icon {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #e53e3e;
        }

    </style>
</head>
<body>

   <a href="/" class="back-home" title="To the main page">
        <i class="fas fa-arrow-left"></i>
        <span>BACK</span>
    </a>

    <div class="theme-toggle" onclick="document.body.classList.toggle('dark-theme')">
        <i class="fas fa-moon"></i>
    </div>

    <div class="auth-container">
        <div class="logo-box">
            <i class="fas fa-tools"></i>
        </div>
        <h1 class="brand-name">Service Center</h1>

        <div class="auth-card">
            <h2>Log in</h2>

           {{#if error}}
                <div class="error-banner">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>{{error}}</span>
                </div>
            {{/if}}

            <form action="/auth/login" method="POST">
                <div class="form-group">
                    <label>Email Address</label>
                    <div class="input-wrapper">
                        <input type="email" name="email" id="email" value="{{values.email}}" placeholder="your@email.com" 
                               class="form-input {{#if errors.email}}is-invalid{{/if}}">
                        {{#if errors.email}}<i class="fas fa-exclamation-circle error-icon"></i>{{/if}}
                    </div>
                    {{#if errors.email}}<div class="error-message">{{errors.email}}</div>{{/if}}
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <div class="input-wrapper">
                        <input type="password" name="password" id="password" placeholder="••••••••" 
                               class="form-input {{#if errors.password}}is-invalid{{/if}}">
                        {{#if errors.password}}<i class="fas fa-exclamation-circle error-icon"></i>{{/if}}
                    </div>
                    {{#if errors.password}}<div class="error-message">{{errors.password}}</div>{{/if}}
                </div>

                <button type="submit" class="btn-submit">Log in</button>
            </form>

            <div style="margin-top: 20px; font-size: 13px; color: var(--text-sub);">
                Don't have an account? <a href="/auth/register" style="color: var(--primary-purple); text-decoration: none; font-weight: 700;">Create Account</a>
            </div>

            <div class="demo-section">
                <span class="demo-label">Demo credentials:</span>
                
                <div class="demo-pill" onclick="fill('client@test.com', 'client123')">
                    <span><b>Client:</b> client@test.com / client123</span>
                    <i class="fas fa-chevron-right" style="opacity: 0.5;"></i>
                </div>
                <div class="demo-pill" onclick="fill('master@test.com', 'master123')">
                    <span><b>Master:</b> master@test.com / master123</span>
                    <i class="fas fa-chevron-right" style="opacity: 0.5;"></i>
                </div>
                <div class="demo-pill" onclick="fill('admin@test.com', 'admin123')">
                    <span><b>Admin:</b> admin@test.com / admin123</span>
                    <i class="fas fa-chevron-right" style="opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>

    <script>
        function fill(e, p) {
            document.getElementById('email').value = e;
            document.getElementById('password').value = p;
        }
    </script>
</body>
</html>