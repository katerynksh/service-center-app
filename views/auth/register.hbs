<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account — Service Center</title>
    
    {{!-- Font Awesome для іконок --}}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        :root {
            --primary-purple: #cbbdf0;
            --hover-purple: #b8a9e0;
            --bg-body: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #2d3748;
            --text-sub: #718096;
            --border-color: #e2e8f0;
            --input-bg: #fcfcfc;
        }

        /* Темна тема на весь екран */
        body.dark-theme {
            --bg-body: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f1f5f9;
            --text-sub: #94a3b8;
            --border-color: #334155;
            --input-bg: #0f172a;
        }

        body, html {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Inter', -apple-system, sans-serif;
            background-color: var(--bg-body);
            transition: background-color 0.3s ease;
        }

        /* Кнопка зміни теми */
        .theme-toggle {
            position: fixed;
            top: 20px;
            right: 20px;
            width: 44px;
            height: 44px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            color: var(--text-main);
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            z-index: 1000;
        }

        .auth-container {
            width: 100%;
            max-width: 400px; /* Квадратна ширина */
            padding: 20px;
            box-sizing: border-box;
            text-align: center;
        }

        .logo-box {
            background-color: var(--primary-purple);
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 auto 15px;
            color: white;
            font-size: 24px;
            box-shadow: 0 4px 12px rgba(203, 189, 240, 0.4);
        }

        .brand-name {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 25px 0;
        }

        /* Картка реєстрації */
        .auth-card {
            background: var(--card-bg);
            padding: 45px 40px; /* Симетричні відступи */
            border-radius: 28px;
            border: 1px solid var(--border-color);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
            box-sizing: border-box;
        }

        .auth-card h2 {
            margin: 0 0 25px 0;
            font-size: 20px;
            color: var(--text-main);
            font-weight: 600;
        }

        .form-group {
            text-align: left;
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-main);
        }

        .form-input {
            width: 100%;
            padding: 13px 15px;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            font-size: 15px;
            background-color: var(--input-bg);
            color: var(--text-main);
            box-sizing: border-box;
            transition: all 0.2s ease;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--primary-purple);
            box-shadow: 0 0 0 4px rgba(203, 189, 240, 0.2);
        }

        .btn-submit {
            width: 100%;
            background-color: var(--primary-purple);
            color: white;
            padding: 14px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
            margin-top: 10px;
        }

        .btn-submit:hover { opacity: 0.9; }
        .btn-submit:active { transform: scale(0.98); }

        .auth-footer {
            margin-top: 25px;
            font-size: 14px;
            color: var(--text-sub);
        }

        .auth-footer a {
            color: var(--primary-purple);
            text-decoration: none;
            font-weight: 700;
        }
    </style>
</head>
<body>

    <div class="theme-toggle" onclick="document.body.classList.toggle('dark-theme')">
        <i class="fas fa-moon"></i>
    </div>

    <div class="auth-container">
        <div class="logo-box">
            <i class="fas fa-tools"></i>
        </div>
        <h1 class="brand-name">Service Center</h1>

        <div class="auth-card">
            <h2>Create Account</h2>

            {{#if error}}
                <div style="color: #e53e3e; font-size: 13px; margin-bottom: 15px; background: #fff5f5; padding: 10px; border-radius: 10px; border: 1px solid #feb2b2;">
                    {{error}}
                </div>
            {{/if}}

            <form action="/auth/register" method="POST">
                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" name="email" placeholder="your@email.com" required class="form-input">
                </div>
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" placeholder="••••••••" required class="form-input">
                </div>
                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" name="confirmPassword" placeholder="••••••••" required class="form-input">
                </div>
                <button type="submit" class="btn-submit">Sign Up</button>
            </form>

            <div class="auth-footer">
                Already have an account? <a href="/auth/login">Sign In</a>
            </div>
        </div>
    </div>

</body>
</html>