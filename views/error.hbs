<div class="container text-center my-5" style="min-height: 60vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
    <h1 class="display-1 text-danger fw-bold">{{status}}</h1>
    <h2 class="mb-4">Something went wrong</h2>
    <p class="lead text-muted mb-4">{{message}}</p>
    
    <div class="mt-2">
        <a href="/" class="btn btn-primary btn-lg px-4 gap-3">Go Home</a>
        <button onclick="history.back()" class="btn btn-outline-secondary btn-lg px-4">Back</button>
    </div>
</div>