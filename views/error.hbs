<div class="container" style="text-align: center; margin-top: 100px;">
    <div class="error-card" style="background-color: #f8d7da; color: #721c24; padding: 30px; border-radius: 10px; border: 1px solid #f5c6cb; display: inline-block; max-width: 500px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
        <h2 style="margin-top: 0; font-size: 24px;">Error {{status}}</h2>
        <p style="font-size: 18px; margin: 20px 0;">
            <strong>Error {{status}}</strong><br>
            {{message}}
        </p>
        <a href="/" style="display: inline-block; background-color: #dc3545; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; font-weight: bold; transition: 0.3s;">
            Go Back to HomePage
        </a>
    </div>
</div>