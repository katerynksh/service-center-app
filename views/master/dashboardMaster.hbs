<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    :root {
        --primary-violet: #ae9ebe; --hover-violet: rgb(145, 132, 179);
        --bg-body: #f8f9fa; --card-bg: #ffffff;
        --text-main: #2d3748; --text-muted: #718096;
        --border-color: #e2e8f0; --row-bg: #f8f9fa; 

        --status-new-bg: #e0f7ff; --status-new-text: #00a8e8; --status-new-border: #00a8e8;
        --status-progress-bg: #fff3e0; --status-progress-text: #ff9800; --status-progress-border: #ff9800;
        --status-waiting-bg: #e0fbff; --status-waiting-text: #00c4cc; --status-waiting-border: #00c4cc;
        --status-parts-bg: #f0f4f8; --status-parts-text: #607d8b; --status-parts-border: #607d8b;
        --status-fail-bg: #ffebee; --status-fail-text: #e53935; --status-fail-border: #e53935;
        --status-done-bg: #e8f5e9; --status-done-text: #43a047; --status-done-border: #43a047;
    }

    body.dark-theme { --bg-body: #0f172a; --card-bg: #1e293b; --text-main: #f1f5f9; --text-muted: #94a3b8; --border-color: #334155; --row-bg: rgba(255, 255, 255, 0.03); }
    body { background-color: var(--bg-body); color: var(--text-main); transition: background 0.3s ease; }

    .dashboard-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .header-brand h1 { font-size: 24px; margin: 0; font-weight: 700; color: var(--text-main); }
    .header-brand p { font-size: 14px; margin: 5px 0 0; color: var(--text-muted); }
    .btn-logout { display: flex; align-items: center; gap: 8px; padding: 8px 16px; border: 1px solid var(--border-color); border-radius: 8px; text-decoration: none; color: var(--text-main); font-size: 14px; font-weight: 500; }
    
    .custom-tabs { display: flex; gap: 10px; margin-bottom: 25px; background: var(--card-bg); padding: 8px; border-radius: 12px; border: 1px solid var(--border-color); }
    {{!-- .custom-tabs .nav-link { flex: 1; text-align: center; color: var(--text-muted); font-weight: 600; padding: 10px; border-radius: 8px; cursor: pointer; border: none; background: transparent; transition: 0.2s; } --}}
    .custom-tabs .nav-link.active { background-color: var(--primary-violet); color: white; }
    .custom-tabs .nav-link { flex: 1; text-align: center; color: var(--text-main); font-weight: 600; padding: 10px; border-radius: 8px; cursor: pointer; border: none; background: transparent; transition: 0.2s; }

    .dark-theme .custom-tabs .nav-link {color: #cbd5e1 !important;}
    .dark-theme .custom-tabs .nav-link:hover {color: #ffffff !important;}
    .dark-theme .custom-tabs .nav-link.active {color: #ffffff !important;}

    .search-container { display: flex; gap: 10px; align-items: center; margin-bottom: 30px; }
    .search-input-wrapper { position: relative; flex: 1; }
    .search-input-wrapper i { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }
    .search-input { width: 100%; padding: 14px 15px 14px 45px; border: 1px solid var(--border-color); border-radius: 12px; background: var(--card-bg); color: var(--text-main); font-size: 14px; outline: none; }
    .search-select { padding: 12px; border-radius: 12px; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-main); font-size: 14px; outline: none; cursor: pointer; }

    .order-card { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 30px; margin-bottom: 25px; transition: all 0.3s ease; }
    .order-card:hover { border-color: var(--primary-violet); box-shadow: 0 8px 24px rgba(203, 189, 240, 0.25); transform: translateY(-2px); }
    .card-top { display: flex; align-items: center; gap: 15px; margin-bottom: 8px; }
    .card-top h3 { margin: 0; font-size: 18px; font-weight: 700; color: var(--text-main); }
    
    .status-badge { font-size: 11px; font-weight: 800; padding: 6px 14px; border-radius: 8px; text-transform: uppercase; letter-spacing: 0.5px; border: 1.5px solid; display: inline-block; }
    .status-new { background: var(--status-new-bg); color: var(--status-new-text); border-color: var(--status-new-border); }
    .status-in-progress { background: var(--status-progress-bg); color: var(--status-progress-text); border-color: var(--status-progress-border); }
    .status-waiting-response { background: var(--status-waiting-bg); color: var(--status-waiting-text); border-color: var(--status-waiting-border); }
    .status-waiting-parts { background: var(--status-parts-bg); color: var(--status-parts-text); border-color: var(--status-parts-border); }
    .status-failed { background: var(--status-fail-bg); color: var(--status-fail-text); border-color: var(--status-fail-border); }
    .status-done { background: var(--status-done-bg); color: var(--status-done-text); border-color: var(--status-done-border); }
    
    .order-id-row { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-muted); margin-bottom: 15px; }
    .issue-desc { font-size: 14px; margin-bottom: 25px; line-height: 1.5; color: var(--text-main); }
    
    .data-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 25px; }
    .data-row { background: var(--row-bg); border-radius: 8px; padding: 12px 15px; display: flex; align-items: center; gap: 12px; font-size: 13px; }
    .data-row i { color: var(--text-muted); width: 16px; text-align: center; }
    .data-row span.label { color: var(--text-muted); }
    .data-row span.value { font-weight: 700; color: var(--text-main); }

    .comment-box { margin-top: 20px; padding: 16px 20px; background: var(--row-bg); border-radius: 14px; border: 1px solid var(--border-color); display: flex; gap: 15px; position: relative; }
    .comment-box::before { content: "TECHNICIAN COMMENT"; position: absolute; top: -9px; left: 15px; background: var(--card-bg); color: var(--text-muted); font-size: 10px; font-weight: 700; padding: 0 8px; letter-spacing: 0.5px; }
    .comment-content p { margin: 0; font-size: 14px; line-height: 1.5; color: var(--text-main); }

    .card-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 25px; padding-top: 20px; border-top: 1px solid var(--border-color); }
    .btn-action { padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; transition: 0.2s; background: var(--card-bg); }
    .btn-action.outline-primary { border: 1px solid var(--primary-violet); color: var(--primary-violet); }
    .btn-action.outline-primary:hover { background: var(--primary-violet); color: white; }
    .btn-action.outline-secondary { border: 1px solid var(--text-muted); color: var(--text-muted); }
    .btn-action.outline-secondary:hover { background: var(--text-muted); color: white; }
    .btn-take-work { background: var(--primary-violet); color: white; width: 100%; text-align: center; justify-content: center; padding: 12px; border: none; border-radius: 10px; font-weight: 700; cursor: pointer; transition: 0.2s; }
    .btn-take-work:hover { background: var(--hover-violet); }
</style>

<div class="dashboard-header mt-4">
    <div class="header-brand">
        <h1>Service Center</h1>
        <p>{{title}} — {{user.name}}</p>
    </div>
    <div style="display: flex; gap: 20px; align-items: center;">
        <i class="fas fa-moon" style="cursor:pointer; font-size: 1.2rem; color: var(--text-main);" onclick="document.body.classList.toggle('dark-theme')"></i>
        <a href="/" class="btn-logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>
</div>

<div class="custom-tabs">
    <button class="nav-link active" id="tab-new" onclick="switchTab('new')">New Orders (0)</button>
    <button class="nav-link" id="tab-my" onclick="switchTab('my')">My Orders (0)</button>
    <button class="nav-link" id="tab-archive" onclick="switchTab('archive')"><i class="fas fa-archive"></i> Archive (0)</button>
</div>

<div class="search-container">
    <div class="search-input-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" id="order-search" class="search-input" placeholder="Search by order ID, model, or client..." oninput="renderOrders()">
    </div>
    <select id="search-category" class="search-select" onchange="renderOrders()">
        <option value="all">All fields</option>
        <option value="status">Status</option>
        <option value="order_id">Order №</option>
        <option value="device_model">Model</option>
        <option value="client_email">Client</option>
        <option value="issue_description">Description</option>
    </select>
</div>

<div id="orders-container"></div>

<script>
    let currentOrders = { newOrders: [], myOrders: [] };
    let activeTab = 'new';

    async function load() {
        const res = await fetch('/master/dashboard');
        currentOrders = await res.json();
        
        const archiveStatuses = ['done', 'failed'];
        const activeMyOrdersCount = currentOrders.myOrders.filter(o => !archiveStatuses.includes(o.status.toLowerCase())).length;
        const archivedOrdersCount = currentOrders.myOrders.filter(o => archiveStatuses.includes(o.status.toLowerCase())).length;
        
        document.getElementById('tab-new').innerText = `New Orders (${currentOrders.newOrders.length})`;
        document.getElementById('tab-my').innerText = `My Orders (${activeMyOrdersCount})`;
        document.getElementById('tab-archive').innerHTML = `<i class="fas fa-archive"></i> Archive (${archivedOrdersCount})`;
        
        renderOrders();
    }

    async function archiveOrder(id) {
    const result = await Swal.fire({
        title: 'Are you sure?',
        text: 'This will move the order to the archive.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, archive it',
        cancelButtonText: 'Cancel'
    });

    if (!result.isConfirmed) return;

    const order = currentOrders.myOrders.find(o => o.order_id === id);
    if (!order) { 
        Swal.fire('Error', 'Order data not found!', 'error'); 
        return; 
    }

    const payload = { status: 'done', comment: order.technician_comment || '', cost: order.cost || 0 };
    
    try {
        const res = await fetch(`/master/order/${id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        if (res.ok) { 
            Swal.fire('Success', 'Order moved to archive successfully!', 'success'); 
            load(); 
        } else { 
            const data = await res.json(); 
            Swal.fire('Error', 'Error: ' + data.error, 'error'); 
        }
    } catch (err) { 
        console.error(err); 
        Swal.fire('Server Error', 'Something went wrong.', 'error'); 
    }
}

function switchTab(tab) {
        activeTab = tab;
        document.querySelectorAll('.nav-link').forEach(btn => btn.classList.remove('active'));
        document.getElementById(`tab-${tab}`).classList.add('active');
        renderOrders();
    }

    function getStatusClass(status) {
        switch(status.toLowerCase()) {
            case 'new': return 'status-new';
            case 'in progress': return 'status-in-progress';
            case 'waiting customer response': return 'status-waiting-response';
            case 'waiting spare parts': return 'status-waiting-parts';
            case 'failed': return 'status-failed';
            case 'done': return 'status-done';
            default: return 'status-new';
        }
    }

    function renderOrders() {
        const container = document.getElementById('orders-container');
        const searchTerm = document.getElementById('order-search').value.toLowerCase();
        const category = document.getElementById('search-category').value;
        const archiveStatuses = ['done', 'failed'];
        
        let orders = [];
        if (activeTab === 'new') { orders = currentOrders.newOrders; } 
        else if (activeTab === 'my') { orders = currentOrders.myOrders.filter(o => !archiveStatuses.includes(o.status.toLowerCase())); } 
        else if (activeTab === 'archive') { orders = currentOrders.myOrders.filter(o => archiveStatuses.includes(o.status.toLowerCase())); }

        if (searchTerm) {
            orders = orders.filter(o => {
                const dataToSearch = { status: (o.status || '').toLowerCase(), order_id: String(o.order_id), device_model: (o.device_model || '').toLowerCase(), client_email: (o.client_email || '').toLowerCase(), issue_description: (o.issue_description || '').toLowerCase() };
                return category === 'all' ? Object.values(dataToSearch).some(val => val.includes(searchTerm)) : dataToSearch[category]?.includes(searchTerm);
            });
        }

        if (orders.length === 0) {
            container.innerHTML = `<div style="text-align:center; padding: 40px; color: var(--text-muted);"><i class="fas ${activeTab === 'archive' ? 'fa-archive' : 'fa-inbox'}" style="font-size: 3rem;"></i><p style="margin-top: 15px;">No orders found in this section.</p></div>`;
            return;
        }

        container.innerHTML = orders.map(o => `
            <div class="order-card">
                <div class="card-top">
                    <h3>${o.device_model}</h3>
                    <span class="status-badge ${getStatusClass(o.status)}">${o.status.toUpperCase()}</span>
                </div>
                <div class="order-id-row">
                    <i class="fas fa-cube"></i> Order №${o.order_id} • ${o.device_type}
                </div>
                <div class="issue-desc">
                    ${o.issue_description}
                </div>
                <div class="data-grid">
                    <div class="data-row">
                        <i class="fas fa-user"></i> <span class="label">Client:</span> 
                        <span class="value">${o.client_name || 'Not specified'} (${o.client_email})</span>
                    </div>
                    <div class="data-row">
                        <i class="fas fa-dollar-sign"></i> <span class="label">Cost:</span> 
                        <span class="value">$${o.cost || '0.00'}</span>
                    </div>
                    <div class="data-row">
                        <i class="fas fa-microchip"></i> <span class="label">OS:</span> 
                        <span class="value">${o.os_version || 'Not specified'}</span>
                    </div>
                    <div class="data-row">
                        <i class="fas fa-user-cog"></i> <span class="label">Created at:</span> 
                        <span class="value">${new Date(o.created_at).toLocaleString()}</span>
                    </div>
                    <div class="data-row">
                        <i class="fas fa-calendar"></i> <span class="label">Purchase:</span> 
                        <span class="value">${o.date_of_purchase ? new Date(o.date_of_purchase).toLocaleDateString() : 'Not specified'}</span>
                    </div>                  
                    <div class="data-row">
                        <i class="fas fa-clock"></i> <span class="label">Last Update:</span> 
                        <span class="value">${new Date(o.updated_at).toLocaleString()}</span>
                    </div>
                </div>

                ${o.technician_comment ? `
                <div class="comment-box">
                    <i class="fas fa-comment-dots" style="color: var(--text-muted); font-size: 16px; margin-top: 3px;"></i>
                    <div class="comment-content"><p>${o.technician_comment}</p></div>
                </div>` : ''}

                ${activeTab === 'new' ? `
                    <div style="margin-top: 20px;">
                        <button onclick="takeInWork(${o.order_id})" class="btn-take-work">Take in Work</button>
                    </div>
                ` : `
                    <div class="card-actions">
                        ${activeTab === 'my' ? `
                        <button onclick="archiveOrder(${o.order_id})" class="btn-action outline-secondary"><i class="fas fa-archive"></i> Archive</button>
                        ` : ''}
                        <a href="/master/edit/${o.order_id}" class="btn-action outline-primary"><i class="fas fa-edit"></i> Edit</a>
                    </div>
                `}
            </div>
        `).join('');
    }

    async function takeInWork(id) {
        const res = await fetch(`/master/order/accept/${id}`, { method: 'PUT' });
        if (res.ok) load();
    }

    load();
</script>