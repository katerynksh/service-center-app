<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Service Center</h4>
        <small class="text-muted">{{title}} — {{user.email}}</small>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-link text-dark p-0"><i class="bi bi-moon"></i></button>
        <a href="/auth/logout" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
            <i class="bi bi-box-arrow-right"></i> Logout
        </a>
    </div>
</div>

    <div class="nav nav-pills nav-justified mb-4 custom-tabs shadow-sm rounded-3">
        <button class="nav-link active" id="tab-new" onclick="switchTab('new')">New Orders (0)</button>
        <button class="nav-link" id="tab-my" onclick="switchTab('my')">My Orders (0)</button>
    </div>

    <div class="input-group mb-4 shadow-sm">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
        <input type="text" id="order-search" class="form-control border-start-0 ps-0" placeholder="Search by order ID, model, or client..." oninput="renderOrders()">
        <select id="search-category" class="form-select border-start-1" style="max-width: 150px;" onchange="renderOrders()">
            <option value="all">All fields</option>
            <option value="order_id">Order №</option>
            <option value="device_model">Model</option>
            <option value="client_email">Client</option>
            <option value="issue_description">Description</option>
        </select>
    </div>

    <div id="orders-container">
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    .custom-tabs { background: white; padding: 5px; }
    
    .custom-tabs .nav-link { color: #6c757d; font-weight: 500; border: none; }
    .custom-tabs .nav-link.active { background-color: #70558d91 !important; color: white; }
    .order-card { border-radius: 12px; border: 1px solid #eee; margin-bottom: 20px; transition: 0.2s; }
    .order-card:hover { border-color: #ccc; }
    .status-badge { border-radius: 6px; font-size: 0.75rem; padding: 4px 8px; font-weight: bold; }
    .info-label { color: #888; font-size: 0.85rem; display: flex; align-items: center; gap: 8px; }
    .info-value { font-weight: 500; font-size: 0.9rem; }
    .comment-box { background: #f8f9fa; border-radius: 8px; padding: 12px; font-size: 0.9rem; border: 1px solid #eee; }
</style>

<script>
    let currentOrders = { newOrders: [], myOrders: [] };
    let activeTab = 'new';

    async function load() {
        const res = await fetch('/master/dashboard');
        currentOrders = await res.json();
        
        // Оновлюємо лічильники на вкладках
        document.getElementById('tab-new').innerText = `New Orders (${currentOrders.newOrders.length})`;
        document.getElementById('tab-my').innerText = `My Orders (${currentOrders.myOrders.length})`;
        
        renderOrders();
    }

    function switchTab(tab) {
        activeTab = tab;
        document.querySelectorAll('.nav-link').forEach(btn => btn.classList.remove('active'));
        document.getElementById(`tab-${tab}`).classList.add('active');
        renderOrders();
    }

function renderOrders() {
        const container = document.getElementById('orders-container');
        const searchTerm = document.getElementById('order-search').value.toLowerCase();
        const category = document.getElementById('search-category').value;

        let orders = activeTab === 'new' ? currentOrders.newOrders : currentOrders.myOrders;
        if (searchTerm) {
            orders = orders.filter(o => {
                const dataToSearch = {
                    order_id: String(o.order_id),
                    device_model: (o.device_model || '').toLowerCase(),
                    client_email: (o.client_email || '').toLowerCase(),
                    issue_description: (o.issue_description || '').toLowerCase()
                };

                if (category === 'all') {
                    return Object.values(dataToSearch).some(val => val.includes(searchTerm));
                } else {
                    return dataToSearch[category]?.includes(searchTerm);
                }
            });
        }

        if (orders.length === 0) {
            container.innerHTML = `<div class="text-center py-5 text-muted">No orders found in this section.</div>`;
            return;
        }

        container.innerHTML = orders.map(o => `
            <div class="card order-card shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="card-title mb-1">${o.device_model} 
                                <span class="status-badge ms-2 ${getStatusClass(o.status)}">${o.status.toUpperCase()}</span>
                            </h5>
                            <small class="text-muted"><i class="bi bi-box"></i> Order №${o.order_id} · ${o.device_type}</small>
                        </div>
                        
                        ${activeTab === 'my' ? `<a href="/master/edit/${o.order_id}" class="btn btn-link text-dark p-0" title="Edit Order"><i class="bi bi-pencil-square fs-5"></i></a>` : ''}
                        
                    </div>

                    <p class="mb-4">${o.issue_description}</p>

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="info-label"><i class="bi bi-person"></i> Client: <span class="info-value text-dark">${o.client_email || 'Not specified'}</span></div>
                            <div class="info-label mt-2"><i class="bi bi-cpu"></i> OS: <span class="info-value text-dark">${o.os_version || 'Not specified'}</span></div>
                            <div class="info-label mt-2"><i class="bi bi-calendar"></i> Created: <span class="info-value text-dark">${new Date(o.created_at).toLocaleString()}</span></div>
                        </div>
                        <div class="col-6">
                            <div class="info-label mt-2"><i class="bi bi-currency-dollar"></i> Cost: <span class="info-value text-dark">$${o.cost || '0.00'}</span></div>
                            <div class="info-label mt-2"><i class="bi bi-clock-history"></i> Updated: <span class="info-value text-dark">${new Date(o.updated_at).toLocaleString()}</span></div>
                        </div>
                    </div>

                    ${o.technician_comment ? `
                        <div class="comment-box">
                            <small class="text-muted d-block mb-1"><i class="bi bi-chat-left-text"></i> Technician Comment:</small>
                            ${o.technician_comment}
                        </div>
                    ` : ''}

                    ${activeTab === 'new' ? `
                        <button onclick="takeInWork(${o.order_id})" class="btn btn-danger w-100 mt-3">
                            Take in Work
                        </button>                    
        ` : ''}
                </div>
            </div>
        `).join('');
    }

    function getStatusClass(status) {
        switch(status) {
            case 'new': return 'bg-warning-subtle text-warning border border-warning';
            case 'in progress': return 'bg-warning-subtle text-warning border border-warning';
            case 'waiting customer response': return 'bg-info-subtle text-info border border-info';
            case 'waiting spare parts': return 'bg-secondary-subtle text-secondary border border-secondary';
            case 'failed': return 'bg-danger-subtle text-danger border border-danger';

            case 'done': return 'bg-success-subtle text-success border border-success';
            default: return 'bg-info-subtle text-info border border-info';
        }
    }

    async function takeInWork(id) {
        const res = await fetch(`/master/order/accept/${id}`, { method: 'PUT' });
        if (res.ok) load();
    }

    load();
</script>