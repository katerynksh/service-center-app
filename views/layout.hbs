<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} | Service Center</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<body class="preload">
    <script>
        const savedTheme = localStorage.getItem('app-theme') || 'light';
        
        if (savedTheme === 'dark') {
            document.body.classList.add('dark-theme');
            document.documentElement.setAttribute('data-bs-theme', 'dark');
        } else {
            document.documentElement.setAttribute('data-bs-theme', 'light');
        }

        // Знімаємо блокування анімацій після завантаження
        window.addEventListener('DOMContentLoaded', () => {
            // Затримка гарантує, що браузер встиг застосувати темні кольори
            setTimeout(() => {
                document.body.classList.remove('preload');
            }, 100);
            
            // Встановлюємо правильну іконку при завантаженні
            if (document.body.classList.contains('dark-theme')) {
                document.querySelectorAll('.theme-icon').forEach(icon => {
                    icon.classList.remove('fa-moon');
                    icon.classList.add('fa-sun');
                });
            }
        });

        // Глобальна функція для кнопки-перемикача
        function toggleTheme() {
            // Дозволяємо анімацію під час кліку користувача
            document.body.classList.remove('preload');
            
            document.body.classList.toggle('dark-theme');
            const isDark = document.body.classList.contains('dark-theme');
            
            localStorage.setItem('app-theme', isDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', isDark ? 'dark' : 'light');
            
            document.querySelectorAll('.theme-icon').forEach(icon => {
                if (isDark) {
                    icon.classList.remove('fa-moon');
                    icon.classList.add('fa-sun'); 
                } else {
                    icon.classList.remove('fa-sun');
                    icon.classList.add('fa-moon');
                }
            });
        }
    </script>

    <main class="container mt-4">
        {{{body}}}
    </main>

    <footer class="text-center mt-5 py-4 text-muted border-top" style="border-color: var(--border-color) !important;">
        <p class="mb-0 small">&copy; 2026 Service Center. All rights reserved.</p>
    </footer>
</body>
</html>