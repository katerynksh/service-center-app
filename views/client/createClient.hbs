<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Repair Order — Service Center</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            /* Фірмові кольори */
            --primary-violet: #cbbdf0;
            --hover-violet: #b8a9e0;
            --focus-violet: #9f7aea;
            --text-main: #1a202c;
            --text-darker: #171923;
            --border-color: #e2e8f0;
        }

        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            width: 100%;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: transparent; 
        }

        /* Ефект розмитого фону поверх дашборду */
        .page-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(26, 32, 44, 0.3); /* Легке затемнення */
            backdrop-filter: blur(12px) saturate(140%); /* РОЗМИТТЯ ТВОГО ДАШБОРДУ */
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        /* Модальне вікно з ефектом "Glassmorphism" */
        .modal-card {
            background: rgba(255, 255, 255, 0.92); /* Напівпрозорий фон картки */
            width: 90%;
            max-width: 500px;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            position: relative;
            overflow: hidden;
            animation: modalAppear 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }

        @keyframes modalAppear {
            from { opacity: 0; transform: translateY(20px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .close-link {
            position: absolute;
            top: 25px;
            right: 25px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 20px;
            z-index: 1001;
            transition: all 0.2s;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .close-link:hover {
            color: var(--text-darker);
            background: rgba(237, 242, 247, 0.8);
            transform: rotate(90deg);
        }

        .modal-header {
            padding: 30px 35px 20px;
        }

        /* ЗМЕНШЕНА ЖИРНІСТЬ ЗАГОЛОВКА */
        .modal-header h2 {
            margin: 0;
            font-size: 22px;
            font-weight: 600; /* Було 800, тепер 600 - виглядає делікатніше */
            color: var(--text-darker);
            letter-spacing: -0.5px;
        }

        .modal-body {
            padding: 10px 35px 25px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 5px;
        }

        .full-width {
            grid-column: span 2;
        }

        label {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-darker);
            margin-left: 2px;
        }

        input, select, textarea {
            padding: 14px;
            border: 2px solid var(--border-color);
            border-radius: 12px;
            font-size: 15px;
            width: 100%;
            box-sizing: border-box;
            background: rgba(248, 250, 252, 0.8);
            color: var(--text-main);
            transition: all 0.2s ease-in-out;
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            background: #fff;
            border-color: var(--focus-violet);
            box-shadow: 0 0 0 4px rgba(159, 122, 234, 0.15);
            transform: translateY(-1px);
        }

        textarea {
            height: 110px;
            resize: none;
        }

        .modal-footer {
            padding: 10px 35px 35px;
            display: flex;
            gap: 15px;
        }

        .btn {
            flex: 1;
            padding: 16px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 15px;
            cursor: pointer;
            border: none;
            text-align: center;
            text-decoration: none;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-create {
            background-color: var(--primary-violet);
            color: #44337a;
            box-shadow: 0 4px 14px 0 rgba(203, 189, 240, 0.5);
        }

        .btn-create:hover {
            background-color: var(--hover-violet);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(203, 189, 240, 0.6);
        }

        .btn-cancel {
            background-color: rgba(241, 245, 249, 0.9);
            color: #475569;
        }

        .btn-cancel:hover {
            background-color: #e2e8f0;
            color: var(--text-darker);
        }
    </style>
</head>
<body>

    <div class="page-overlay">
        <div class="modal-card">
            <a href="/client/dashboard" class="close-link" title="Close">
                <i class="fas fa-times"></i>
            </a>
            
            <div class="modal-header">
                <h2>Create New Repair Order</h2>
            </div>

            <form action="/client/create" method="POST">
                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Device Type</label>
                            <select name="device_type" required>
                                <option value="" disabled selected>Select type</option>
                                <option value="Smartphone">Smartphone</option>
                                <option value="Tablet">Tablet</option>
                                <option value="Laptop">Laptop</option>
                                <option value="Desktop">Desktop</option>
                                <option value="Smartwatch">Smartwatch</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Device Model</label>
                            <input type="text" name="device_model" placeholder="e.g., iPhone 13 Pro" required>
                        </div>

                        <div class="form-group">
                            <label>OS Version (Optional)</label>
                            <input type="text" name="os_version" placeholder="e.g., iOS 17.2">
                        </div>

                        <div class="form-group">
                            <label>Purchase Date (Optional)</label>
                            <input type="date" name="date_of_purchase">
                        </div>

                        <div class="form-group full-width">
                            <label>Issue Description</label>
                            <textarea name="issue_description" placeholder="Describe the issue in detail..." required></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <a href="/client/dashboard" class="btn btn-cancel">Cancel</a>
                    <button type="submit" class="btn btn-create">Create Order</button>
                </div>
            </form>
        </div>
    </div>

</body>
</html>