<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 fw-bold">Service Center</h4>
            <small class="text-muted">Admin Dashboard</small>
        </div>
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-link text-dark p-0"><i class="bi bi-moon"></i></button>
            <a href="/api/auth/logout" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                <i class="bi bi-box-arrow-right"></i> Logout
            </a>
        </div>
    </div>

    <div class="nav nav-pills nav-justified mb-4 custom-tabs shadow-sm rounded-3">
        <button class="nav-link active" id="tab-orders" onclick="switchTab('orders')">All Orders (0)</button>
        <button class="nav-link" id="tab-masters" onclick="switchTab('masters')"><i class="bi bi-tools me-1"></i> Masters (0)</button>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-danger rounded-pill px-4 shadow-sm" onclick="location.href='/api/admin/create-order'">
            <i class="bi bi-plus-lg"></i> Create New Order
        </button>
    </div>

    <div class="input-group mb-4 shadow-sm rounded-3 overflow-hidden">
        <span class="input-group-text bg-white border-end-0 ps-3"><i class="bi bi-search text-muted"></i></span>
        <input type="text" id="adminSearch" class="form-control border-start-0 ps-2 py-2" placeholder="Search orders or masters...">
    </div>

    <div id="admin-content-container"></div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    .custom-tabs { background: white; padding: 5px; }
    .custom-tabs .nav-link { color: #6c757d; font-weight: 500; border: none; }
    .custom-tabs .nav-link.active { background-color: #dc3545 !important; color: white; }
    
    .admin-card { border-radius: 12px; border: 1px solid #eee; margin-bottom: 20px; transition: 0.2s; }
    .stat-box { border-radius: 10px; padding: 15px; flex: 1; }
    .bg-active { background-color: #fff8f0; }
    .bg-completed { background-color: #f0fdf4; }
    .bg-total { background-color: #f8f9fa; border: 1px solid #eee; }
    
    .stat-label { font-size: 0.8rem; color: #6c757d; display: flex; align-items: center; gap: 6px; }
    .stat-value { font-size: 1.5rem; font-weight: 700; margin-top: 5px; }
    .order-id-badge { font-size: 0.8rem; color: #6c757d; }
</style>

<script>
    let allData = { orders: [], masters: [] };
    let activeTab = 'orders'; 

    async function loadAdminData() {
        const res = await fetch('/api/admin/all-info');
        allData = await res.json();
        
        document.getElementById('tab-orders').innerText = `All Orders (${allData.orders.length})`;
        document.getElementById('tab-masters').innerText = `Masters (${allData.masters.length})`;
        
        renderContent();
    }

    // Функція видалення замовлення
    async function deleteOrder(id) {
        if (!confirm('Are you sure you want to PERMANENTLY delete this order?')) return;
        
        try {
            const res = await fetch(`/api/admin/orders/${id}`, { method: 'DELETE' });
            if (res.ok) {
                alert('Order deleted successfully');
                loadAdminData(); // Оновити список
            }
        } catch (err) {
            console.error(err);
        }
    }
    async function setMaster(orderId) {
        const email = prompt("Enter master's email:");
        if (!email) return;

        try {
            const res = await fetch('/api/admin/assign-master', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    orderId: parseInt(orderId), // Перетворюємо в число про всяк випадок
                    masterEmail: email 
                })
            });

            const data = await res.json();

            if (res.ok) {
                alert("Master assigned successfully!");
                loadAdminData(); // Оновлюємо список
            } else {
                // Тепер ви побачите в alert конкретну причину помилки
                alert("Error: " + data.error);
            }
        } catch (err) {
            console.error(err);
            alert("Server connection error");
        }
    }

    function switchTab(tab) {
        activeTab = tab;
        document.querySelectorAll('.nav-link').forEach(btn => btn.classList.remove('active'));
        document.getElementById(`tab-${tab}`).classList.add('active');
        renderContent();
    }

    function renderContent() {
        const container = document.getElementById('admin-content-container');
    
        if (activeTab === 'masters') {
            const addButtonHtml = `
                <div class="d-flex justify-content-end mb-3">
                    <button class="btn btn-dark btn-sm rounded-pill px-4 shadow-sm" onclick="location.href='/api/admin/create-master'">
                        <i class="bi bi-person-plus-fill me-1"></i> Add New Master
                    </button>
                </div>
            `;

            const mastersListHtml = allData.masters.map(m => `
                <div class="card admin-card shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-1">${m.email.split('@')[0]}</h5>
                        <div class="text-muted small mb-3"><i class="bi bi-envelope"></i> ${m.email}</div>
                        <div class="d-flex gap-3">
                            <div class="stat-box bg-active">
                                <div class="stat-label"><i class="bi bi-clock"></i> Active</div>
                                <div class="stat-value text-dark">${m.active_orders}</div>
                            </div>
                            <div class="stat-box bg-completed">
                                <div class="stat-label"><i class="bi bi-check-circle"></i> Completed</div>
                                <div class="stat-value text-dark">${m.completed_orders}</div>
                            </div>
                            <div class="stat-box bg-total">
                                <div class="stat-label">Total Orders</div>
                                <div class="stat-value text-dark">${m.total_orders}</div>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');

            container.innerHTML = addButtonHtml + mastersListHtml;
        } else {
            container.innerHTML = allData.orders.map(o => `
                <div class="card admin-card shadow-sm">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-1">${o.device_model}</h5>
                            <div class="order-id-badge"><i class="bi bi-box"></i> Order №${o.order_id} • ${o.status.toUpperCase()}</div>
                            ${o.assigned_to ? 
                                `<div class="text-success small mt-1"><i class="bi bi-person-check"></i> Master: ${o.master_email}</div>` : 
                                `<div class="text-danger small mt-1"><i class="bi bi-exclamation-circle"></i> Unassigned</div>`
                            }
                        </div>
                        <div class="d-flex gap-2">
                            ${!o.assigned_to ? `
                                <button onclick="setMaster(${o.order_id})" class="btn btn-outline-success btn-sm rounded-pill px-3">
                                    <i class="bi bi-person-plus"></i> Assign
                                </button>
                            ` : ''}
                            
                            <a href="/api/admin/edit/${o.order_id}" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <button onclick="deleteOrder(${o.order_id})" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }
    }

    loadAdminData();
</script>