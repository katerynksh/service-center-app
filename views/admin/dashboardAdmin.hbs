<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Service Center</h4>
        <small class="text-muted">{{title}} — {{user.name}}</small>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-link text-dark p-0"><i class="bi bi-moon"></i></button>
        <a href="/" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
            <i class="bi bi-box-arrow-right"></i> Logout
        </a>
    </div>
</div>  

    <div class="nav nav-pills nav-justified mb-4 custom-tabs shadow-sm rounded-3">
        <button class="nav-link active" id="tab-orders" onclick="switchTab('orders')">Active Orders (0)</button>
        <button class="nav-link" id="tab-archive" onclick="switchTab('archive')"><i class="bi bi-archive me-1"></i> Archive (0)</button>
        <button class="nav-link" id="tab-masters" onclick="switchTab('masters')"><i class="bi bi-tools me-1"></i> Masters (0)</button>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-danger rounded-pill px-4 shadow-sm" onclick="location.href='/admin/create-order'">
            <i class="bi bi-plus-lg"></i> Create New Order
        </button>
    </div>

    <div id="search-container">
        <div id="order-search-block" class="input-group mb-4 shadow-sm">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" id="order-search" class="form-control border-start-0 ps-0" placeholder="Search orders..." oninput="renderContent()">
            <select id="search-category" class="form-select border-start-1" style="max-width: 150px;" onchange="renderContent()">
                <option value="all">All fields</option>
                <option value="order_id">Order №</option>
                <option value="device_model">Model</option>
                <option value="status">Status</option>
            </select>
        </div>

        <div id="master-search-block" class="input-group mb-4 shadow-sm d-none">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-person-search"></i></span>
            <input type="text" id="master-search" class="form-control border-start-0 ps-0" placeholder="Search masters..." oninput="renderContent()">
            <select id="master-search-category" class="form-select border-start-1" style="max-width: 150px;" onchange="renderContent()">
                <option value="all">All fields</option>
                <option value="email">Email</option>
                <option value="id">Master ID</option>
            </select>
        </div>
    </div>

    <div id="admin-content-container"></div>
</div> 

<dialog id="assignDialog" style="border: none; border-radius: 12px; padding: 25px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); width: 350px; max-width: 90%;">
    <h5 class="fw-bold mb-3" id="dialogTitle">Assign Master</h5>
    <input type="hidden" id="dialogOrderId">
    
    <div class="mb-3">
        <label class="form-label text-muted small">Select a master from the list:</label>
        <select id="dialogMasterSelect" class="form-select mt-1">
            </select>
    </div>
    
    <div class="d-flex justify-content-end gap-2 mt-4">
        <button onclick="document.getElementById('assignDialog').close()" class="btn btn-light border px-3">Cancel</button>
        <button onclick="confirmDialogAssign()" class="btn btn-primary px-4">Assign</button>
    </div>
</dialog>

<style>
    .custom-tabs { background: white; padding: 5px; }
    .custom-tabs .nav-link { color: #6c757d; font-weight: 500; border: none; }
    .custom-tabs .nav-link.active { background-color: #70558d91 !important; color: white; }
    
    .admin-card { border-radius: 12px; border: 1px solid #eee; margin-bottom: 20px; transition: 0.2s; }
    .stat-box { border-radius: 10px; padding: 15px; flex: 1; }
    .bg-active { background-color: #fff8f0; }
    .bg-completed { background-color: #f0fdf4; }
    
    .stat-label { font-size: 0.8rem; color: #6c757d; display: flex; align-items: center; gap: 6px; }
    .stat-value { font-size: 1.5rem; font-weight: 700; margin-top: 5px; }
    .order-id-badge { font-size: 0.8rem; color: #6c757d; }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    let allData = { orders: [], masters: [] };
    let activeTab = 'orders'; 

    async function loadAdminData() {
        const res = await fetch('/admin/all-info');
        allData = await res.json();
        
        const archiveStatuses = ['done', 'failed'];
        const activeOrdersCount = allData.orders.filter(o => !archiveStatuses.includes(o.status.toLowerCase())).length;
        const archiveOrdersCount = allData.orders.filter(o => archiveStatuses.includes(o.status.toLowerCase())).length;
        
        document.getElementById('tab-orders').innerText = `Active Orders (${activeOrdersCount})`;
        document.getElementById('tab-archive').innerHTML = `<i class="bi bi-archive me-1"></i> Archive (${archiveOrdersCount})`;
        document.getElementById('tab-masters').innerHTML = `<i class="bi bi-tools me-1"></i> Masters (${allData.masters.length})`;
        
        renderContent();
    }

    // Функція для ручного перенесення в архів
    async function archiveOrder(id) {
        if (!confirm('Move this order to archive (set status to DONE)?')) return;
        
        // 1. Знаходимо поточне замовлення в нашому масиві даних
        const order = allData.orders.find(o => o.order_id === id);
        if (!order) {
            alert('Order data not found!');
            return;
        }

        // 2. Формуємо повний об'єкт даних, щоб бекенд не затер інші поля нулями,
        // але примусово ставимо status: 'done'
        const payload = {
            device_type: order.device_type,
            device_model: order.device_model,
            os_version: order.os_version,
            issue_description: order.issue_description,
            status: 'done', // Змінюємо тільки статус
            cost: order.cost || 0,
            assigned_to: order.assigned_to || "",
            technician_comment: order.technician_comment || ""
        };
        
        try {
            // 3. Відправляємо запит на правильний маршрут для редагування замовлень
            const res = await fetch(`/admin/orders/${id}`, { 
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                alert('Order moved to archive successfully!');
                loadAdminData(); 
            } else {
                const data = await res.json();
                alert('Error: ' + data.error);
            }
        } catch (err) {
            console.error(err);
            alert('Server error');
        }
    }

    async function deleteOrder(id) {
        if (!confirm('Are you sure you want to PERMANENTLY delete this order?')) return;
        try {
            const res = await fetch(`/admin/orders/${id}`, { method: 'DELETE' });
            if (res.ok) {
                alert('Order deleted successfully');
                loadAdminData();
            }
        } catch (err) {
            console.error(err);
        }
    }

    function setMaster(orderId) {
        document.getElementById('dialogOrderId').value = orderId;
        document.getElementById('dialogTitle').innerText = `Assign Master to Order №${orderId}`;
        const select = document.getElementById('dialogMasterSelect');
        select.innerHTML = '<option value="" disabled selected>Select a master...</option>' + 
            allData.masters.map(m => `<option value="${m.email}">${m.email}</option>`).join('');
        document.getElementById('assignDialog').showModal();
    }

    async function confirmDialogAssign() {
        const orderId = document.getElementById('dialogOrderId').value;
        const email = document.getElementById('dialogMasterSelect').value;
        if (!email) { alert("Please select a master!"); return; }

        try {
            const res = await fetch('/admin/assign-master', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId: parseInt(orderId), masterEmail: email })
            });
            if (res.ok) {
                alert("Master assigned successfully!");
                document.getElementById('assignDialog').close(); 
                loadAdminData(); 
            }
        } catch (err) { console.error(err); }
    }

    function switchTab(tab) {
        activeTab = tab;
        document.querySelectorAll('.nav-link').forEach(btn => btn.classList.remove('active'));
        document.getElementById(`tab-${tab}`).classList.add('active');
        
        if (tab === 'orders' || tab === 'archive') {
            document.getElementById('order-search-block').classList.remove('d-none');
            document.getElementById('master-search-block').classList.add('d-none');
        } else {
            document.getElementById('order-search-block').classList.add('d-none');
            document.getElementById('master-search-block').classList.remove('d-none');
        }
        renderContent();
    }

    function renderContent() {
        const container = document.getElementById('admin-content-container');
        if (activeTab === 'masters') {
            const term = document.getElementById('master-search').value.toLowerCase();
            const cat = document.getElementById('master-search-category').value;
            let filteredMasters = allData.masters.filter(m => {
                if (!term) return true;
                const fields = { id: String(m.id), email: m.email.toLowerCase() };
                return cat === 'all' ? Object.values(fields).some(v => v.includes(term)) : fields[cat]?.includes(term);
            });
            container.innerHTML = `<div class="d-flex justify-content-end mb-3"><button class="btn btn-outline-primary btn-sm rounded-pill px-4 shadow-sm" onclick="location.href='/admin/create-master'"><i class="bi bi-person-plus-fill me-1"></i> Add New Master</button></div>` + filteredMasters.map(m => `
                <div class="card admin-card shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-1">${m.email.split('@')[0]}</h5>
                        <div class="text-muted small mb-3"><i class="bi bi-envelope"></i> ${m.email}</div>
                        <div class="d-flex gap-3">
                            <div class="stat-box bg-active"><div class="stat-label"><i class="bi bi-clock"></i> Active</div><div class="stat-value">${m.active_orders || 0}</div></div>
                            <div class="stat-box bg-completed"><div class="stat-label"><i class="bi bi-check-circle"></i> Completed</div><div class="stat-value">${m.completed_orders || 0}</div></div>
                        </div>
                    </div>
                </div>
            `).join('');
        } else {
            const term = document.getElementById('order-search').value.toLowerCase();
            const cat = document.getElementById('search-category').value;
            const archiveStatuses = ['done', 'failed'];
            
            let targetOrders = activeTab === 'orders' 
                ? allData.orders.filter(o => !archiveStatuses.includes(o.status.toLowerCase()))
                : allData.orders.filter(o => archiveStatuses.includes(o.status.toLowerCase()));

            let filteredOrders = targetOrders.filter(o => {
                if (!term) return true;
                const fields = { order_id: String(o.order_id), device_model: o.device_model.toLowerCase(), status: o.status.toLowerCase(), client_email: (o.client_email || "").toLowerCase() };
                return cat === 'all' ? Object.values(fields).some(v => v.includes(term)) : fields[cat]?.includes(term);
            });

            if (filteredOrders.length === 0) {
                container.innerHTML = `<div class="text-center py-5 text-muted"><i class="bi ${activeTab === 'archive' ? 'bi-archive' : 'bi-inbox'} display-4"></i><p class="mt-3">No orders found.</p></div>`;
                return;
            }

            container.innerHTML = filteredOrders.map(o => `
                <div class="card admin-card shadow-sm">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-1">${o.device_model}</h5>
                            <div class="order-id-badge"><i class="bi bi-box"></i> Order №${o.order_id} • ${o.status.toUpperCase()}</div>
                            ${o.assigned_to 
                                ? `<div class="text-muted small mt-1"><i class="bi bi-person-check"></i> Master: <strong>${allData.masters.find(m => m.id === o.assigned_to)?.email || o.master_email || o.assigned_to}</strong></div>` 
                                : `<div class="text-muted small mt-1 text-warning"><i class="bi bi-person-x"></i> Unassigned</div>`}
                        </div>
                        <div class="d-flex gap-2">
                            ${activeTab === 'orders' ? `
                            <button onclick="archiveOrder(${o.order_id})" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                <i class="bi bi-archive"></i> Archive
                            </button>
                            <button onclick="setMaster(${o.order_id})" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                <i class="bi bi-person-plus"></i> Assign
                            </button>
                            ` : ''}

                            <a href="/admin/edit/${o.order_id}" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil"></i> Edit</a>
                            <button onclick="deleteOrder(${o.order_id})" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }
    }
    loadAdminData();
</script>