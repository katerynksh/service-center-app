<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Admin Management</h2>
        <div class="input-group w-25">
            <input type="text" class="form-control form-control-sm rounded-pill" placeholder="Search orders...">
        </div>
    </div>

    <div id="admin-orders-list" class="row g-3">
        </div>
</div>

<script>
    async function loadAdminData() {
        try {
            const response = await fetch('/api/admin/all-info');
            const { orders, masters } = await response.json();
            const container = document.getElementById('admin-orders-list');

            container.innerHTML = orders.map(order => {
                const isNew = order.status === 'new';
                const statusClass = order.status.replace(' ', '-');
                const masterOptions = masters.map(m => `<option value="${m.id}">${m.email}</option>`).join('');

                return `
                    <div class="col-12">
                        <div class="order-card p-4 shadow-sm bg-white rounded-3 border">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h5 class="fw-bold mb-1">${order.device_model} <span class="badge-status status-${statusClass} ms-2 text-uppercase" style="font-size: 0.7rem;">${order.status}</span></h5>
                                    <p class="text-muted small mb-3">Order ID: #${order.order_id} • Client: ${order.client_email || 'Guest'}</p>
                                </div>
                                <div class="text-end">
                                    ${isNew ? `
                                        <div class="d-flex gap-2">
                                            <select id="select-master-${order.order_id}" class="form-select form-select-sm rounded-3">
                                                <option value="">Assign technician...</option>
                                                ${masterOptions}
                                            </select>
                                            <button onclick="assignMaster(${order.order_id})" class="btn btn-sm btn-danger px-3">Assign</button>
                                        </div>
                                    ` : `<span class="text-success fw-bold small"><i class="bi bi-check-circle"></i> Assigned to ${order.master_email}</span>`}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('') || '<p class="text-center py-5 text-muted">No orders found.</p>';
        } catch (err) { console.error(err); }
    }

    async function assignMaster(orderId) {
        const masterId = document.getElementById(`select-master-${orderId}`).value;
        if (!masterId) return alert('Select a technician!');
        const res = await fetch('/api/admin/assign', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId, masterId })
        });
        if (res.ok) loadAdminData();
    }
    loadAdminData();
</script>