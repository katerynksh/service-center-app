<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3" style="max-width: 500px; margin: 0 auto;">
        <div class="card-header bg-white border-bottom-0 pt-4 px-4 text-center">
            <h4 class="fw-bold mb-0">Register New Master</h4>
            <p class="text-muted small">Create an account for a service technician</p>
        </div>
        <div class="card-body p-4">
            <form id="createMasterForm">
                <div class="mb-3">
                    <label class="form-label text-muted small">Master Email</label>
                    <input type="email" class="form-control" name="email" placeholder="master@service.com" required>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted small">Master Name</label>
                    <input type="name" name="name" class="form-control" placeholder="Master Name" required>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">Set Password</label>
                    <input type="password" class="form-control" name="password" minlength="6" placeholder="Minimum 6 characters" required>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-danger rounded-pill">Create Master Account</button>
                    <a href="/admin" class="btn btn-outline-secondary rounded-pill">Back to Dashboard</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('createMasterForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = Object.fromEntries(new FormData(e.target));

    try {
        const res = await fetch('/admin/masters', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        });

        const data = await res.json();

        if (res.ok) {
            alert('Master account created successfully!');
            window.location.href = '/admin'; 
        } else {
            alert('Error: ' + data.error);
        }
    } catch (err) {
        console.error(err);
        alert('Server connection error');
    }
});
</script>