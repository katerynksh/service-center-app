<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white border-bottom-0 pt-4 px-4">
            <h4 class="fw-bold mb-0">Create New Order</h4>
        </div>
        <div class="card-body p-4">
            <form id="createOrderForm" novalidate>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Client Email (New Client)</label>
                        <input type="email" class="form-control" name="client_email" placeholder="example@mail.com" required>
                        <div class="error-text">Please enter a valid email address</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Client Name</label>
                        <input type="name" name="client_name" class="form-control" placeholder="Client Name" required>
                        <div class="error-text">Please enter a valid client name</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Set Client Password</label>
                        <input type="password" class="form-control" name="client_password" placeholder="Minimum 6 characters" required>
                        <div class="error-text">Password must be at least 6 characters long</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Device Model</label>
                        <input type="text" class="form-control" name="device_model" placeholder="iPhone 15 Pro" required>
                        <div class="error-text">Please enter a device model</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Device Type</label>
                        <input type="text" class="form-control" name="device_type" placeholder="Smartphone" required>
                        <div class="error-text">Please enter a device type</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">OS Version</label>
                        <input type="text" class="form-control" name="os_version" placeholder="iOS 17.0">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Date of Purchase (Optional)</label>
                        <input type="date" class="form-control" name="date_of_purchase">
                    </div>
                    <div class="col-12">
                        <label class="form-label text-muted small">Issue Description</label>
                        <textarea class="form-control" name="issue_description" rows="3" placeholder="Describe the problem..." required></textarea>
                        <div class="error-text">Please enter an issue description</div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-danger px-4 rounded-pill">Create Order</button>
                    <a href="/admin" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('createOrderForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    
    // Очищення попередніх помилок
    form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
    form.querySelectorAll('.error-text').forEach(el => el.style.display = 'none');

    let isValid = true;

    // Перевірка на порожні значення
    form.querySelectorAll('[required]').forEach(field => {
        if (!field.value.trim()) {
            isValid = false;
            field.classList.add('is-invalid');
            const errorDiv = field.nextElementSibling;
            if (errorDiv && errorDiv.classList.contains('error-text')) {
                errorDiv.innerText = 'This field is required';
                errorDiv.style.display = 'block';
            }
        }
    });

    // Валідація Email
    const emailField = form.querySelector('input[type="email"]');
    if (emailField && emailField.value.trim()) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(emailField.value.trim())) {
            isValid = false;
            emailField.classList.add('is-invalid');
            const errorDiv = emailField.nextElementSibling;
            if (errorDiv && errorDiv.classList.contains('error-text')) {
                errorDiv.innerText = 'Please enter a valid email address';
                errorDiv.style.display = 'block';
            }
        }
    }

    // Валідація довжини пароля
    const passwordField = form.querySelector('input[type="password"]');
    if (passwordField && passwordField.value.trim() && passwordField.value.length < 6) {
        isValid = false;
        passwordField.classList.add('is-invalid');
        const errorDiv = passwordField.nextElementSibling;
        if (errorDiv && errorDiv.classList.contains('error-text')) {
            errorDiv.innerText = 'Password must be at least 6 characters long';
            errorDiv.style.display = 'block';
        }
    }

    // Валідація імені клієнта
    const nameField = form.querySelector('input[name="client_name"]');
    const nameRegex = /^[a-zA-Zа-яА-ЯіІїЇєЄґҐ\s\-\']+$/;
    if (nameField && (!nameField.value.trim() || !nameRegex.test(nameField.value.trim()))) {
        isValid = false;
        nameField.classList.add('is-invalid');
        const errorDiv = nameField.nextElementSibling;
        if (errorDiv && errorDiv.classList.contains('error-text')) {
            errorDiv.innerText = 'Client name should only contain letters, spaces, hyphens, and apostrophes';
            errorDiv.style.display = 'block';
        }
    }

    // Валідація дати покупки (від 1900 року до сьогодні)
    const dateField = form.querySelector('input[name="date_of_purchase"]');
    if (dateField && dateField.value) {
        const selectedDate = new Date(dateField.value);
        const today = new Date();
        today.setHours(23, 59, 59, 999); // Враховуємо весь сьогоднішній день
        const minDate = new Date('1900-01-01'); 
        
        if (selectedDate > today || selectedDate < minDate) {
            isValid = false;
            dateField.classList.add('is-invalid');
            
            let errorDiv = dateField.nextElementSibling;
            if (!errorDiv || !errorDiv.classList.contains('error-text')) {
                errorDiv = document.createElement('div');
                errorDiv.className = 'error-text text-danger mt-1 small';
                dateField.parentNode.insertBefore(errorDiv, dateField.nextSibling);
            }
            errorDiv.innerText = 'Please select a valid purchase date (between 1900 and today)';
            errorDiv.style.display = 'block';
        }
    }

    if (!isValid) return; 

    const formData = Object.fromEntries(new FormData(form));

    try {
        const res = await fetch('/admin/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        });
        if (res.ok) {
            alert('Order created successfully!');
            window.location.href = '/admin';
        } else {
            const err = await res.json();
            alert('Error: ' + err.error);
        }
    } catch (err) {
        console.error(err);
        alert('Failed to send request');
    }
});
</script>