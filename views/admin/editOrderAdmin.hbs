<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white border-bottom-0 pt-4 px-4">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="fw-bold mb-0">Edit Order №<span id="order-id-display">{{order.order_id}}</span></h4>
                <button onclick="confirmDelete({{order.order_id}})" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash"></i> Delete Order
                </button>
            </div>
        </div>
        <div class="card-body p-4">
            <form id="adminEditForm">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small">Device Model</label>
                        <input type="text" class="form-control" name="device_model" value="{{order.device_model}}" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Type</label>
                        <input type="text" class="form-control" name="device_type" value="{{order.device_type}}" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small">OS Version</label>
                        <input type="text" class="form-control" name="os_version" value="{{order.os_version}}">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label text-muted small">Status</label>
                        <select class="form-select" name="status">
                            <option value="new" {{#if (eq order.status 'new')}}selected{{/if}}>NEW</option>
                            <option value="in progress" {{#if (eq order.status 'in progress')}}selected{{/if}}>IN PROGRESS</option>
                            <option value="waiting customer response" {{#if (eq order.status 'waiting customer response')}}selected{{/if}}>WAITING CUSTOMER RESPONSE</option>
                            <option value="waiting spare parts" {{#if (eq order.status 'waiting spare parts')}}selected{{/if}}>WAITING SPARE PARTS</option>
                            <option value="failed" {{#if (eq order.status 'failed')}}selected{{/if}}>FAILED</option>
                            <option value="done" {{#if (eq order.status 'done')}}selected{{/if}}>DONE</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted small">Repair Cost ($)</label>
                        <input type="number" step="0.01" class="form-control" name="cost" value="{{order.cost}}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted small">Assigned Master</label>
                        <select class="form-select" name="assigned_to">
                            <option value="">Unassigned</option>
                            {{#each masters}}
                                <option value="{{this.id}}" {{#if (eq ../order.assigned_to this.id)}}selected{{/if}}>
                                    {{this.email}}
                                </option>                            
                            {{/each}}
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label text-muted small">Issue Description</label>
                        <textarea class="form-control" name="issue_description" rows="3">{{order.issue_description}}</textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label text-muted small">Technician Comment</label>
                        <textarea class="form-control" name="technician_comment" rows="2">{{order.technician_comment}}</textarea>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-danger px-4 rounded-pill">Save All Changes</button>
                    <a href="/admin" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.getElementById('adminEditForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = Object.fromEntries(new FormData(e.target));

    if (formData.cost && parseFloat(formData.cost) < 0) {
        alert("Cost cannot be negative!");
        return;
    }

    const id = document.getElementById('order-id-display').innerText;

    const res = await fetch(`/admin/orders/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(formData)
    });

    if (res.ok) {
        alert('Order updated successfully!');
        window.location.href = '/admin';
    }
});

async function confirmDelete(id) {
    if (confirm('Are you sure you want to PERMANENTLY delete this order?')) {
        const res = await fetch(`/admin/orders/${id}`, { method: 'DELETE' });
        if (res.ok) window.location.href = '/admin';
    }
}
</script>